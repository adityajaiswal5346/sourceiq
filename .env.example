# DocuMind — Environment Variables
#  to .env and fill in real values. Never commit .env to the repo.

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# ── Pinecone (vector database) ─────────────────────────────────────────────
# Get from: pinecone.io → API Keys
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=documind               # must match the index name you created

# ── Voyage AI (embeddings) ─────────────────────────────────────────────────
# Get from: voyageai.com → Dashboard → API Keys
# Free tier: 50M tokens/month
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-2                 # 1024-dim — must match Pinecone index dimensions

# ── Cohere (reranking) ─────────────────────────────────────────────────────
# Get from: cohere.com → API Keys
# Free tier: 1,000 reranks/month
COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=rerank-english-v3.0

# ── PostgreSQL (Neon) ──────────────────────────────────────────────────────
# Get from: neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=documind-docs               # create this bucket in AWS S3

# ── RAG tuning parameters ──────────────────────────────────────────────────
# Adjust per document collection without code changes
CHUNK_SIZE=800                        # tokens per chunk
CHUNK_OVERLAP=100                     # overlap between adjacent chunks
TOP_K_RETRIEVAL=10                    # candidates from Pinecone before reranking
TOP_K_RERANK=5                        # final chunks passed to Claude after reranking
HYBRID_ALPHA=0.7                      # 0.0 = keyword only, 1.0 = semantic only

# ── App ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Auth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# ── Langfuse ───────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
CONFIDENCE_THRESHOLD=0.6
